# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
# Python build dirs at repo root only - do not ignore frontend/lib/ (Next.js modules)
/lib/
/lib64/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
# NEVER commit .env - it contains your SECRET_KEY and DATABASE_URL
.env

# Google OAuth client JSON from Cloud Console (contains client_secret)
client_secret*.json

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Testing & coverage
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
nosetests.xml

# ---------------------------------------------------------------------------
# Alembic
# ---------------------------------------------------------------------------
# Migration files are committed - only ignore compiled bytecode
alembic/versions/*.pyc

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.bak
*.tmp
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------------
firebase-credentials.json

# ---------------------------------------------------------------------------
# Claude / Cursor local worktrees (nested git repos; never commit)
# ---------------------------------------------------------------------------
.claude/worktrees/

# Root-level ad-hoc scripts (e.g. test_explore_api.py, test_live_api.py).
# Use leading / so patterns apply only at repo root - bare test_*.py would also
# ignore the real pytest suite under tests/ and scripts such as scripts/test_*.py.
/test_*.py
/fix_alembic.py
/clear_cache.py

# ---------------------------------------------------------------------------
# OSM ETL local data (large; download separately)
# ---------------------------------------------------------------------------
data/raw.geojson
data/raw.geojson.state
data/usa/
data/filtered.csv
scripts/*.pbf
scripts/*.osm.pbf
scripts/tiger/
etl_log.txt
osm_etl.lock
ci_log.zip
openapi_prod.json
spatial_log.txt
spatial_err.txt
scripts/check_*.py

# Monorepo: postbuild mirror writes repo-root .next for Vercel finalization
/.next/

# Local CI sqlite scratch
test.db
test_ci_sim.db

# Monorepo: postbuild symlinks repo-root node_modules for Vercel finalization
/node_modules/

# Vercel monorepo finalize script output at repo root
/.env.production
